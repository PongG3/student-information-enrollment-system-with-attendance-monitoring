# Production settings for the SIES server. Copy to ".env" ON THE SERVER ONLY. Never share or commit .env.
APP_NAME="SIES Campus Portal"
APP_ENV=production
APP_KEY=                      # run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://sies.school.local   # the address people type, with https://

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sies_prod
DB_USERNAME=sies_app          # NOT root
DB_PASSWORD=                  # long and random, 16+ characters, letters and digits only (no quotes or backslashes)

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
